{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bytebase Auth Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://demo.bytebase.com/v1/users",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List users."
        },
        {
          "info": {
            "name": "Create a user (or service account).",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://demo.bytebase.com/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user (or service account)."
        }
      ]
    }
  ],
  "bundled": true
}