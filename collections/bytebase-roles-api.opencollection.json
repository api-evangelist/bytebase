{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bytebase Auth Roles API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List custom and predefined roles.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://demo.bytebase.com/v1/roles"
          },
          "docs": "List custom and predefined roles."
        }
      ]
    }
  ],
  "bundled": true
}